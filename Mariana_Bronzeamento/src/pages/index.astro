---
import lucide from "lucide-react";
import Layout from "../layouts/Layout.astro";

const { ArrowUpRight, AtSign, Check, Clock3, MapPin, Phone, Sparkles, Star } = lucide;

const whatsappNumber = "5544997218436";
const whatsapp = (message: string) => `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
const book = (service = "meu bronze") => whatsapp(`Olá, Mariana! Quero agendar ${service}.`);
const benefits = [
  { title: "Pele radiante", copy: "Um tom iluminado e uniforme, com aspecto natural." },
  { title: "Resultado imediato", copy: "Uma escolha prática para eventos e ocasiões especiais." },
  { title: "Mais autoestima", copy: "Um cuidado para você se sentir ainda mais confiante." },
  { title: "Feito para durar", copy: "Técnica e produtos de qualidade para prolongar seu resultado." },
];
const sessions = [
  { name: "Natural", price: "130", detail: "Bronze gradual, uniforme e de aspecto natural.", note: "Para começar" },
  { name: "A jato", price: "180", detail: "Aplicação profissional para uma cor mais intensa e rápida.", note: "Resultado imediato", featured: true },
  { name: "Flash Bronze", price: "250", detail: "Uma opção expressa para um resultado marcante.", note: "Para a sua ocasião" },
];
const packages = [
  { name: "3x Natural", price: "360", each: "R$120 por sessão", saving: "Economize R$30" },
  { name: "5x Natural", price: "550", each: "R$110 por sessão", saving: "Economize R$100", featured: true },
  { name: "3x A jato", price: "510", each: "R$170 por sessão", saving: "Economize R$30" },
];
const testimonials = [
  { text: "Meu protocolo foi perfeito, sério. Já quero fazer de novo!", author: "Cliente, via WhatsApp", image: "/images/Cliente_1.webp" },
  { text: "Tô numa autoestima... tá muito perfeito, tô apaixonada.", author: "Cliente, via WhatsApp", image: "/images/Cliente_2.webp" },
  { text: "Me senti muito confortável. Seu atendimento é demais!", author: "Cliente, via WhatsApp", image: "/images/Cliente_3.webp" },
];
---

<Layout>
  <header class="site-header fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-ink/90 backdrop-blur-md">
    <div class="mx-auto flex h-[76px] max-w-7xl items-center justify-between gap-5 px-5 sm:px-8">
      <a href="#inicio" class="flex items-center gap-3" aria-label="Mariana Barbosa, início">
        <img src="/images/logo.jpg" alt="Marca Mariana Barbosa Bronzeamento Natural" width="44" height="44" decoding="async" class="h-11 w-11 rounded-full object-cover ring-1 ring-gold/60" />
        <span class="leading-tight text-white"><span class="block font-display text-xl font-semibold tracking-wide">Mariana Barbosa</span><span class="block font-display text-sm italic text-gold-light">Bronzeamento natural</span></span>
      </a>
      <nav class="hidden items-center gap-7 text-xs font-semibold uppercase tracking-[0.16em] text-white/75 lg:flex" aria-label="Navegação principal">
        <a href="#sessoes" class="nav-link">Sessões</a><a href="#pacotes" class="nav-link">Pacotes</a><a href="#depoimentos" class="nav-link">Depoimentos</a><a href="#contato" class="nav-link">Contato</a>
      </nav>
      <a href={book()} target="_blank" rel="noreferrer" class="button-gold hidden sm:inline-flex">Agendar <ArrowUpRight size={16} aria-hidden="true" /></a>
      <a href={book()} target="_blank" rel="noreferrer" class="whatsapp-icon-only grid h-11 w-11 place-items-center rounded-full border border-gold/60 text-gold sm:hidden" aria-label="Agendar pelo WhatsApp"></a>
    </div>
  </header>

  <main id="inicio" class="overflow-hidden bg-ink pt-[76px] text-white">
    <section class="hero-shell relative isolate border-b border-white/10">
      <div class="hero-aura absolute inset-0 -z-10"></div>
      <div class="mx-auto grid min-h-[660px] max-w-7xl items-center gap-12 px-5 py-16 sm:px-8 lg:grid-cols-[1.05fr_.95fr] lg:py-20">
        <div class="max-w-2xl">
          <p class="mb-6 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.19em] text-gold-light"><span class="h-px w-8 bg-gold"></span> Paranavaí · atendimento com hora marcada</p>
          <h1 class="max-w-[10ch] font-display text-[clamp(3.4rem,8vw,7rem)] font-medium leading-[.82] tracking-[-0.035em] text-white"><span class="hero-word" style="--delay:90ms">O seu</span><span class="hero-word text-gold-light italic" style="--delay:180ms">bronze</span><span class="hero-word" style="--delay:270ms">começa aqui.</span></h1>
          <p class="mt-8 max-w-lg text-base leading-8 text-white/70 sm:text-lg">Um bronze natural, uniforme e pensado para realçar o que você já tem de bonito — com cuidado em cada etapa.</p>
          <div class="mt-9 flex flex-wrap items-center gap-4"><a href={book()} target="_blank" rel="noreferrer" class="button-gold">Agendar pelo WhatsApp <ArrowUpRight size={17} aria-hidden="true" /></a><a href="#sessoes" class="button-quiet">Conhecer sessões</a></div>
          <div class="mt-12 flex items-center gap-4 border-t border-white/15 pt-5 text-sm text-white/65"><div class="flex gap-0.5 text-gold" aria-label="Avaliação máxima">{[1,2,3,4,5].map(() => <Star size={14} fill="currentColor" aria-hidden="true" />)}</div><span>Clientes que voltam pela experiência.</span></div>
        </div>
        <figure class="relative mx-auto w-full max-w-[500px] lg:justify-self-end">
          <div class="absolute -inset-5 border border-gold/30 [clip-path:polygon(14%_0,100%_0,100%_86%,86%_100%,0_100%,0_14%)]"></div>
          <img src="/images/Cliente_1.webp" alt="Resultado de bronzeamento da Mariana Barbosa" width="740" height="986" fetchpriority="high" decoding="async" class="relative aspect-[4/5] w-full object-cover [clip-path:polygon(8%_0,100%_0,100%_92%,92%_100%,0_100%,0_8%)]" />
          <figcaption class="absolute -bottom-7 -left-3 max-w-[230px] border border-gold/30 bg-ink p-5 shadow-[0_18px_40px_rgba(0,0,0,.3)] sm:-left-8"><span class="font-display text-2xl italic text-gold-light">Do seu jeito</span><p class="mt-1 text-xs leading-5 text-white/65">Orientação para você escolher a sessão certa.</p></figcaption>
        </figure>
      </div>
    </section>

    <section class="border-b border-white/10 bg-ink-soft py-20 sm:py-28"><div class="mx-auto grid max-w-7xl items-start gap-12 px-5 sm:px-8 lg:grid-cols-[.72fr_1.28fr]"><h2 class="font-display text-5xl leading-[.9] tracking-[-0.03em] text-white sm:text-6xl">Muito além<br /><em class="text-gold-light">da cor.</em></h2><div class="grid gap-px overflow-hidden border border-white/10 bg-white/10 sm:grid-cols-2">{benefits.map((benefit, index) => (<article class="benefit-cell bg-ink-soft p-7 sm:p-8" data-reveal style={`--reveal-delay:${index * 60}ms`}><span class="font-display text-lg italic text-gold">0{index + 1}</span><h3 class="mt-9 text-lg font-semibold text-white">{benefit.title}</h3><p class="mt-2 max-w-[30ch] text-sm leading-6 text-white/60">{benefit.copy}</p></article>))}</div></div></section>

    <section class="bg-sand py-20 text-ink sm:py-28"><div class="mx-auto grid max-w-7xl items-center gap-14 px-5 sm:px-8 lg:grid-cols-[.94fr_1.06fr]"><figure class="relative order-2 lg:order-1"><img src="/images/Processo_Bronzeamento.webp" alt="Mariana preparando uma sessão de bronzeamento natural" width="800" height="800" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" /><figcaption class="absolute bottom-0 right-0 max-w-[270px] bg-ink px-6 py-5 text-sm leading-6 text-white">Sua sessão acontece em um ambiente acolhedor, com atenção aos detalhes.</figcaption></figure><div class="order-1 max-w-xl lg:order-2"><Sparkles class="text-gold-dark" size={24} aria-hidden="true" /><h2 class="mt-6 font-display text-5xl leading-[.88] tracking-[-0.03em] sm:text-6xl">Beleza que respeita o seu ritmo.</h2><p class="mt-7 text-base leading-8 text-ink/70 sm:text-lg">Cada sessão é pensada para que você se sinta confortável, segura e saia com uma marquinha que combine com você.</p><ul class="mt-8 space-y-4 border-t border-ink/15 pt-7 text-sm font-medium text-ink/80"><li class="flex gap-3"><Check class="mt-0.5 shrink-0 text-gold-dark" size={17} aria-hidden="true" /> Protocolo orientado para o seu tom de pele</li><li class="flex gap-3"><Check class="mt-0.5 shrink-0 text-gold-dark" size={17} aria-hidden="true" /> Ambiente privativo, higiênico e acolhedor</li><li class="flex gap-3"><Check class="mt-0.5 shrink-0 text-gold-dark" size={17} aria-hidden="true" /> Cuidados pré e pós explicados sem complicação</li></ul></div></div></section>

    <section id="sessoes" class="border-y border-white/10 bg-ink py-20 sm:py-28"><div class="mx-auto max-w-7xl px-5 sm:px-8"><div class="flex flex-col justify-between gap-6 border-b border-white/15 pb-9 sm:flex-row sm:items-end"><div><h2 class="font-display text-5xl leading-none tracking-[-0.03em] sm:text-6xl">Sessões</h2><p class="mt-4 max-w-xl text-base leading-7 text-white/65">Escolha o seu ponto de partida. Se preferir, a Mariana te orienta pelo WhatsApp.</p></div><span class="font-display text-xl italic text-gold-light">a partir de R$130</span></div><div class="divide-y divide-white/15">{sessions.map((session, index) => (<article class={`service-row grid gap-5 py-8 sm:grid-cols-[60px_1fr_auto] sm:items-center sm:gap-8 ${session.featured ? "service-row-featured" : ""}`} data-reveal style={`--reveal-delay:${index * 80}ms`}><span class="font-display text-2xl italic text-gold">0{index + 1}</span><div><div class="flex flex-wrap items-center gap-3"><h3 class="font-display text-3xl text-white sm:text-4xl">Sessão {session.name}</h3><span class="border border-gold/40 px-2 py-1 text-[10px] font-bold uppercase tracking-[.16em] text-gold-light">{session.note}</span></div><p class="mt-2 max-w-xl text-sm leading-6 text-white/60">{session.detail}</p></div><div class="flex items-center justify-between gap-7 sm:justify-end"><p class="text-right"><span class="text-xs text-white/55">R$</span> <strong class="font-display text-4xl font-medium text-white tabular-nums">{session.price}</strong></p><a href={book(`a Sessão ${session.name}`)} target="_blank" rel="noreferrer" class="text-gold transition hover:text-gold-light" aria-label={`Agendar sessão ${session.name}`}><ArrowUpRight size={25} aria-hidden="true" /></a></div></article>))}</div></div></section>

    <section id="pacotes" class="bg-gold-light py-20 text-ink sm:py-28"><div class="mx-auto max-w-7xl px-5 sm:px-8"><div class="max-w-2xl"><h2 class="font-display text-5xl leading-[.9] tracking-[-0.03em] sm:text-6xl">Mais sessões,<br /><em>mais vantagem.</em></h2><p class="mt-5 text-base leading-7 text-ink/70">A economia fica clara para você decidir sem pressa.</p></div><div class="mt-12 grid gap-4 lg:grid-cols-3">{packages.map((pack, index) => (<article class={`package-card flex min-h-[310px] flex-col justify-between p-7 sm:p-8 ${pack.featured ? "package-card-featured" : ""}`} data-reveal style={`--reveal-delay:${index * 80}ms`}><div>{pack.featured && <span class="inline-block bg-gold px-3 py-1 text-[10px] font-bold uppercase tracking-[.15em] text-ink">Melhor valor</span>}<h3 class="mt-7 font-display text-4xl leading-none">Pacote {pack.name}</h3><p class="mt-6 text-sm font-semibold uppercase tracking-[.13em] text-gold-dark">{pack.saving}</p></div><div class="border-t border-current/20 pt-5"><p class="font-display text-5xl tabular-nums">R${pack.price}</p><p class="mt-2 text-sm opacity-70">{pack.each}</p><a href={book(`o Pacote ${pack.name}`)} target="_blank" rel="noreferrer" class="mt-6 inline-flex items-center gap-2 text-sm font-bold underline decoration-gold underline-offset-4">Quero este pacote <ArrowUpRight size={16} aria-hidden="true" /></a></div></article>))}</div></div></section>

    <section class="bg-ink-soft py-20 sm:py-28"><div class="mx-auto max-w-7xl px-5 sm:px-8"><div class="grid gap-8 border-b border-white/15 pb-9 lg:grid-cols-[1fr_.7fr] lg:items-end"><h2 class="font-display text-5xl leading-[.9] tracking-[-0.03em] sm:text-6xl">Pequenos detalhes.<br /><em class="text-gold-light">Outro resultado.</em></h2><p class="text-base leading-7 text-white/65">Complemente o seu momento. Consulte disponibilidade e valores pelo WhatsApp.</p></div><div class="grid border-l border-t border-white/15 sm:grid-cols-2 lg:grid-cols-4">{["Banho de lua", "Spa corporal", "Tatuagem solar", "Adesivo sexy"].map((extra, index) => (<a href={book(`informações sobre ${extra}`)} target="_blank" rel="noreferrer" class="extra-link border-b border-r border-white/15 p-7" data-reveal style={`--reveal-delay:${index * 50}ms`}><span class="block text-[10px] font-semibold uppercase tracking-[.18em] text-gold">Extra 0{index + 1}</span><span class="mt-12 flex items-end justify-between gap-4 font-display text-3xl leading-none text-white">{extra}<ArrowUpRight class="shrink-0 text-gold" size={19} aria-hidden="true" /></span></a>))}</div></div></section>

    <section id="depoimentos" class="bg-sand py-20 text-ink sm:py-28"><div class="mx-auto max-w-7xl px-5 sm:px-8"><h2 class="max-w-[11ch] font-display text-5xl leading-[.9] tracking-[-0.03em] sm:text-6xl">Elas contam melhor.</h2><div class="mt-12 grid gap-px overflow-hidden border border-ink/15 bg-ink/15 lg:grid-cols-3">{testimonials.map((testimonial, index) => (<figure class="testimonial bg-sand p-7 sm:p-8" data-reveal style={`--reveal-delay:${index * 75}ms`}><div class="flex gap-0.5 text-gold-dark" aria-label="Cinco estrelas">{[1,2,3,4,5].map(() => <Star size={14} fill="currentColor" aria-hidden="true" />)}</div><blockquote class="mt-9 font-display text-3xl leading-[1.05] text-ink">“{testimonial.text}”</blockquote><figcaption class="mt-10 flex items-center gap-3 text-sm text-ink/60"><img src={testimonial.image} alt="" width="144" height="192" loading="lazy" decoding="async" class="h-9 w-9 rounded-full object-cover" /> {testimonial.author}</figcaption></figure>))}</div></div></section>

    <section id="contato" class="border-t border-white/10 bg-ink py-20 sm:py-28"><div class="mx-auto grid max-w-7xl gap-14 px-5 sm:px-8 lg:grid-cols-[1.15fr_.85fr]"><div><h2 class="font-display text-5xl leading-[.9] tracking-[-0.03em] sm:text-6xl">Seu próximo bronze<br /><em class="text-gold-light">começa numa conversa.</em></h2><a href={book()} target="_blank" rel="noreferrer" class="button-gold mt-9">Falar com a Mariana <ArrowUpRight size={17} aria-hidden="true" /></a></div><address class="not-italic text-sm leading-7 text-white/70"><div class="contact-line"><MapPin class="text-gold" size={19} aria-hidden="true" /><span><strong class="block font-semibold text-white">Vila Citi, atrás do Gugão</strong>Paranavaí · PR</span></div><div class="contact-line"><Phone class="text-gold" size={19} aria-hidden="true" /><a href="tel:+5544997218436" class="transition hover:text-gold-light">(44) 99721-8436</a></div><div class="contact-line"><Clock3 class="text-gold" size={19} aria-hidden="true" /><span>Segunda a sábado<br />Mediante agendamento</span></div><div class="contact-line"><AtSign class="text-gold" size={19} aria-hidden="true" /><a href="https://www.instagram.com/marianabarbosabronzeamento/" target="_blank" rel="noreferrer" class="transition hover:text-gold-light">@marianabarbosabronzeamento</a></div></address></div></section>
  </main>
  <footer class="border-t border-white/10 bg-ink py-8 text-center text-xs text-white/45">© 2026 Mariana Barbosa · Bronzeamento Natural</footer>
  <a href={book()} target="_blank" rel="noreferrer" class="whatsapp-float" aria-label="Agendar pelo WhatsApp"><span>Agendar</span></a>
</Layout>
