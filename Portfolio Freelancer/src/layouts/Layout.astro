---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title?: string; description?: string; ogImage?: string; }
const {
  title = 'Gabriel Leal — Sites com personalidade',
  description = 'Design e desenvolvimento de sites para negócios que querem uma presença digital com personalidade. Conheça os projetos e vamos conversar.',
  ogImage = '/open-graph/home.png',
} = Astro.props;
const siteOrigin = import.meta.env.PUBLIC_SITE_URL || Astro.site?.origin || Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin);
const ogImageUrl = new URL(ogImage, siteOrigin);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content={description}/><meta name="robots" content="noindex, nofollow"/>
    <link rel="canonical" href={canonicalUrl}/>
    <meta property="og:locale" content="pt_BR"/><meta property="og:type" content="website"/>
    <meta property="og:title" content={title}/><meta property="og:description" content={description}/>
    <meta property="og:url" content={canonicalUrl}/><meta property="og:image" content={ogImageUrl}/>
    <meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/>
    <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImageUrl}/>
    <meta name="theme-color" content="#ffffff"/><title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="preload" href="/fonts/anton.ttf" as="font" type="font/ttf" crossorigin/>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body id="topo">
    <Header/>
    <main id="conteudo"><slot/></main>
    <Footer/>
    <script>import '../scripts/navigation';</script>
  </body>
</html>
