---
import Layout from '../../../layouts/Layout.astro';
import { projects, whatsapp } from '../../../data/projects';
import { Button } from '../../../components/ui/button';
export function getStaticPaths() { return projects.map((project, index) => ({ params:{slug: project.slug}, props: { project, next: projects[(index + 1) % projects.length] } })); }
const { project: p, next } = Astro.props;
---
<Layout title={`${p.name} — Gabriel Leal`} description={p.description} ogImage={`/open-graph/${p.slug}.png`}>
  <section class="case-intro">
    <div class="case-top"><a class="text-link" href="/prototype/#projetos">← Todos os projetos</a><span>{p.number} / 04 · {p.type}</span></div>
    <h1>{p.name}</h1><div class="case-lead"><p>{p.headline}</p><span>{p.category}<br/>{p.type}<br/>Design & desenvolvimento</span></div>
  </section>
  <section class="case-art" style={`--project-color:${p.color}`}><div class="desktop-frame"><div class="browser-bar" aria-hidden="true"><span>● ● ●</span><span>{p.name}</span><span>↗</span></div><img src={p.image} width="1440" height="900" alt={`Visão da página inicial de ${p.name}`}/></div></section>
  <section class="case-story"><div><span class="eyebrow">O CONTEXTO</span><h2>{p.headline}</h2></div><div><p>{p.description}</p></div></section>
  <section class="case-details" style={`--project-color:${p.color}`}><img class="case-detail-screen" src={p.detail} alt={`Detalhe da composição e do conteúdo de ${p.name}`} width="1440" height="900" loading="lazy"/><div class="case-phone"><img src={p.mobile} alt={`Composição responsiva de ${p.name}`} width="390" height="780" loading="lazy"/></div></section>
  <section class="case-story"><div><span class="eyebrow">DA DIREÇÃO À CONSTRUÇÃO</span><h2>Forma e função,<br/>no mesmo projeto.</h2></div><div><h3>A direção visual</h3><p>{p.decision}</p><h3>O que foi construído</h3><p>{p.delivery}</p><Button asChild variant="outline"><a href={whatsapp} target="_blank" rel="noopener noreferrer">Quero conversar sobre meu site ↗</a></Button></div></section>
  <a class="next-project" href={`/prototype/projetos/${next.slug}/`}><span>PRÓXIMO PROJETO / {next.number}</span><strong>{next.name}</strong><span aria-hidden="true">↗</span></a>
</Layout>
