---
import "@/styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Élan Estética — Seu tempo de cuidar começa agora",
  description = "Clínica de estética avançada com tratamentos personalizados para face, corpo e bem-estar em um ambiente acolhedor e exclusivo.",
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=elan2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=elan2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=elan2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=elan2" />
    <link rel="shortcut icon" href="/favicon.ico?v=elan2" />
    <meta name="theme-color" content="#26372F" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Preload LCP Hero Image (Mobile e Desktop) -->
    <link
      rel="preload"
      as="image"
      href="/images/hero-facial-mobile.webp"
      type="image/webp"
      media="(max-width: 768px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href="/images/hero-facial.webp"
      type="image/webp"
      media="(min-width: 769px)"
      fetchpriority="high"
    />

    <!-- Otimização de Fontes do Google (Non-render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap"
      />
    </noscript>
  </head>
  <body class="bg-elan-bg text-elan-text antialiased selection:bg-elan-green selection:text-white">
    <slot />

    <script>
      import { initAnimations } from "@/scripts/animations";

      // Initialize GSAP animations when document is ready
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initAnimations);
      } else {
        initAnimations();
      }
    </script>
  </body>
</html>
