import Specialist from "@/components/Specialist.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
  title="Élan Estética — Seu tempo de cuidar começa agora"
  description="Clínica de estética avançada com tratamentos personalizados para face, corpo e bem-estar."
>
  <Header />
  <main>
    <Hero />
    <Rituals />
    <CareSection />
    <Highlights />
    <Testimonials />
